# Optional external path prefix for the tool host (normally supplied by the proxy).
# TOOL_HOST_BASE_PATH=/suburl

# SQLite database location, relative to the working directory or absolute.
FEEDVANTA_DB=data/feedvanta.db

# Google OAuth web client credentials.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# Generate with: openssl rand -hex 32
FEEDVANTA_SESSION_SECRET=replace-with-a-long-random-value

# Enable in production when FeedVanta is served over HTTPS.
FEEDVANTA_SECURE_COOKIES=false
